    masterProductID:=value('PMDM.AT.PDS.MasterProductID'),
    result:=if(
        len(masterProductID)&amp;gt;0,
        masterProductID,
        iterate(
            iterate(
                referencesto('Product', 'PMDM.PRT.GoldenToSourceRecord'),
                'referenceowner()'
            ),
            'value(&amp;quot;PMDM.AT.PDS.MasterProductID&amp;quot;)'
        )
    )
}
