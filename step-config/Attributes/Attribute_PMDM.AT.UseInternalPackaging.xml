    <AttributeList>
        <Attribute ID="PMDM.AT.UseInternalPackaging" MultiValued="false" ProductMode="Property" FullTextIndexed="false" ExternallyMaintained="true" Derived="false" HierarchicalFiltering="false" ClassificationHierarchicalFiltering="false" Selected="true" Referenced="true" Mandatory="false">
            <Name>Use Internal Packaging</Name>
            <ListOfValueLink ListOfValueID="PMDM.LOV.YesNoExternal"></ListOfValueLink>
            <MetaData>
                <Value AttributeID="PMDM.AT.HelpText">By default, this setting is set to "No".  If set to "Yes", then any time an external source record is approved for onboarding and causes the matching and linking process to be executed, the system will check to see if the record has a packaging hierarchy. It it does, then the packaging hierarchy will be duplicated and included as maintainable objects linked to the newly created internal source record.</Value>
            </MetaData>
