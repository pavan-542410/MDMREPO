<?xml version="1.0" encoding="UTF-8"?>
<STEP-ProductInformation ContextID="Context1" WorkspaceID="Approved" UseContextLocale="false">
    <AttributeList>
        <Attribute ID="a_AddressConcat" MultiValued="false" ProductMode="Property" FullTextIndexed="false" ExternallyMaintained="false" Derived="true" Selected="true" Referenced="true" Mandatory="false">
            <Name>Address</Name>
            <Validation BaseType="text" MinValue="" MaxValue="" MaxLength="1000" InputMask=""></Validation>
            <ValueTemplate>&lt;derive expr="upper(
    concatenate(
        if(
            value('a_AddressType')='Physical Address',
            trim(
                concatenate(
                    value('a_AddressLine1'),
                    ' ',
                    value('a_AddressLine2'),
		' ',
		value('a_AddressLine3')
                )
            ),
            concatenate(
                'PO Box ',
                 value('a_POBox')
            )
        ),
        ', ',
        trim(
            concatenate(
                value('a_City'),
                ' ',
                valuelovid('a_State'),
                ' ',
                value('a_ZipCode')
            )
        ),
        ', ',
        valuelovid('a_CountryCode')
    )
)"/&gt;</ValueTemplate>
            <AttributeGroupLink AttributeGroupID="ag_AddressDetails"></AttributeGroupLink>
            <AttributeGroupLink AttributeGroupID="ag_Internal"></AttributeGroupLink>
            <UserTypeLink UserTypeID="Address"></UserTypeLink>
            <UserTypeLink UserTypeID="LegacyAddress"></UserTypeLink>
        </Attribute>
    </AttributeList>
</STEP-ProductInformation>